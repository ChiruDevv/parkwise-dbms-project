# MySQL database created from parkwise_mysql_commands.sql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=parkwise

# MongoDB sensor feed (the app remains usable if this is unset/offline)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=parkwise
MONGODB_COLLECTION=PARKING_SENSOR_DATA

# Use a long random value (at least 32 characters) in local deployment.
SESSION_SECRET=replace-with-a-long-random-secret-value
# Accounts registered with this email receive the Admin role.
ADMIN_EMAIL=admin@parkwise.local

# Parking pricing (INR per hour)
PARKING_RATE_PER_HOUR=50

# Reservation reminder email through Resend. Use a verified sender address.
RESEND_API_KEY=
EMAIL_FROM=
REMINDER_LEAD_MINUTES=60
